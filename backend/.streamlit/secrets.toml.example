# 비밀 설정 템플릿.
# 이 파일을 `secrets.toml` 로 복사하고 본인 값으로 교체하세요.
# `secrets.toml` 은 절대 git 에 커밋하지 마세요 (.gitignore 등록 필수).

# ─── Streamlit 관리자 대시보드 ───
# 우선순위: secrets.toml(admin_password) → 환경변수 ADMIN_PASSWORD → 미설정 시 오류
admin_password = "여기에-강력한-비밀번호-입력"

# ─── FastAPI 백엔드 (port 8503) — 외부 프론트엔드 호출용 ───
# api_key      : 일반 엔드포인트 (검토·조회) — 프론트 BFF (.env.local) 의 CGR_API_KEY 와 일치
# admin_api_key: 관리자 엔드포인트 (편집·캐시 비우기)
api_key = "dev-api-key-change-me"
admin_api_key = "dev-admin-key-change-me"

# ─── OpenAI API 키 — LLM 호출용 ───
# 우선순위: 환경변수 OPENAI_API_KEY → secrets.toml(openai_api_key) → (옛) local_config.py
# dev 환경에서는 여기에 박는 것이 편함. 운영은 환경변수 권장.
# 키 형식: "sk-proj-..." 또는 "sk-..."
openai_api_key = "sk-여기에-실제-OpenAI-키-입력"
